{
  "name": "Pixel · 像素",
  "short": "pixel",
  "description": "8-bit 复古像素风的极简探针主题，黑框硬阴影、方块进度条与像素字体。",
  "version": "1.3.7",
  "author": "Gongsc",
  "url": "https://github.com/Gongsc/Theme-Pixel",
  "config": [
    {
      "type": "title",
      "label": "基础"
    },
    {
      "key": "defaultTheme",
      "type": "select",
      "label": "默认配色",
      "default": "system",
      "help": "访客未手动切换时使用的配色",
      "options": [
        {
          "value": "system",
          "label": "跟随系统"
        },
        {
          "value": "light",
          "label": "亮色"
        },
        {
          "value": "dark",
          "label": "暗色"
        }
      ]
    },
    {
      "key": "cardLayout",
      "type": "select",
      "label": "默认布局",
      "default": "grid",
      "help": "访客可在首页自行切换",
      "options": [
        {
          "value": "grid",
          "label": "卡片"
        },
        {
          "value": "list",
          "label": "列表"
        }
      ]
    },
    {
      "key": "animatedBackground",
      "type": "boolean",
      "label": "背景动态效果",
      "default": true,
      "help": "开启为动态背景；关闭为静态背景，停止云朵、植物、数据光点和信号灯动画。系统开启减少动态效果时优先使用静态背景"
    },
    {
      "key": "logoUrl",
      "type": "string",
      "label": "自定义 Logo 地址",
      "default": "",
      "help": "可选：覆盖顶栏 Logo，支持图片 URL 或站内路径；留空时跟随 Hub 后台的站点图标，加载失败时依次回退到站点图标和默认风向鸡图标"
    },
    {
      "key": "pixelFont",
      "type": "boolean",
      "label": "中文像素字体",
      "default": true,
      "help": "使用缝合像素字体（Fusion Pixel）显示中文，关闭则使用系统字体"
    },
    {
      "type": "title",
      "label": "首页"
    },
    {
      "key": "notice",
      "type": "text",
      "label": "公告",
      "default": "",
      "help": "显示在首页顶部，纯文本"
    },
    {
      "key": "showSummary",
      "type": "boolean",
      "label": "显示概览",
      "default": true
    },
    {
      "key": "showPrice",
      "type": "boolean",
      "label": "显示价格",
      "default": false,
      "help": "显示节点卡片与详情页的价格和付费周期；关闭时对所有人隐藏"
    },
    {
      "key": "hidePriceForGuests",
      "type": "boolean",
      "label": "对未登录访客隐藏价格与付费周期",
      "default": false,
      "help": "仅在开启「显示价格」时生效；开启后仅已登录用户可见，关闭后访客也可见"
    },
    {
      "key": "hideOffline",
      "type": "boolean",
      "label": "隐藏离线节点",
      "default": false
    },
    {
      "key": "showPing",
      "type": "boolean",
      "label": "显示延迟",
      "default": true,
      "help": "在节点卡片与列表中显示探测线路的最新延迟和丢包；每分钟为每个在线节点请求一次近 1 小时的延迟记录"
    },
    {
      "key": "pingProbes",
      "type": "number",
      "label": "卡片延迟线路数",
      "default": 3,
      "min": 1,
      "max": 6,
      "help": "每张节点卡片最多显示的探测线路数量；填写了「显示的延迟线路」时不生效"
    },
    {
      "key": "pingNames",
      "type": "string",
      "label": "显示的延迟线路",
      "default": "",
      "help": "要在卡片和列表中显示的探测线路名称，用逗号隔开并按此顺序显示，例如：浙江电信,浙江联通,浙江移动；留空则按后台线路排序显示前几条线路"
    },
    {
      "type": "title",
      "label": "详情"
    },
    {
      "key": "defaultRange",
      "type": "select",
      "label": "默认时间范围",
      "default": "1",
      "help": "超过 Hub 保留天数时，使用可用的最长范围",
      "options": [
        {
          "value": "1",
          "label": "1 小时"
        },
        {
          "value": "6",
          "label": "6 小时"
        },
        {
          "value": "24",
          "label": "24 小时"
        },
        {
          "value": "168",
          "label": "7 天"
        },
        {
          "value": "720",
          "label": "30 天"
        },
        {
          "value": "2160",
          "label": "90 天"
        }
      ]
    }
  ]
}
